<Window x:Class="MynAI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MynAssistant Ayarlar"
        Width="900"
        Height="640"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#080D13"
        Foreground="#EAF0F7">

    <Window.Resources>

        <Style x:Key="NavButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Margin"
                    Value="0,3"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#8995A8"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="BorderBrush"
                    Value="Transparent"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#121B27"/>

                    <Setter Property="Foreground"
                            Value="#FFFFFF"/>

                </Trigger>

                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"
                             Value="Active">
                    <Setter Property="Background" Value="#10283B"/>
                    <Setter Property="Foreground" Value="#F5FBFF"/>
                    <Setter Property="BorderBrush" Value="#20A9D8"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="Card"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#101720"/>

            <Setter Property="BorderBrush"
                    Value="#243247"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="18"/>

            <Setter Property="Margin"
                    Value="0,0,0,14"/>

        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#1597E5"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="14,8"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background"
                    Value="#172231"/>

            <Setter Property="BorderBrush"
                    Value="#2A3B52"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <Style x:Key="LogoOptionCard"
               TargetType="ToggleButton">
            <Setter Property="Height" Value="142"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Background" Value="#0B121B"/>
            <Setter Property="Foreground" Value="#DDE7F2"/>
            <Setter Property="BorderBrush" Value="#26374B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#14202D"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#4C657D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#10283B"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#1DB6E5"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">

            <Setter Property="Width"
                    Value="7"/>

            <Setter Property="Background"
                    Value="#0D131B"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="ScrollBar">

                        <Grid>

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>

                                            <ControlTemplate
                                                TargetType="Thumb">

                                                <Border
                                                    Background="#33445A"
                                                    CornerRadius="4"
                                                    Margin="1"/>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL MENÜ -->

        <Border Grid.Column="0"
                Background="#0B1118"
                BorderBrush="#1B2635"
                BorderThickness="0,0,1,0">

            <Grid Margin="14">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>

                    <StackPanel HorizontalAlignment="Stretch"
                                Margin="0,2,0,16">

                        <Border Width="78"
                                Height="78"
                                HorizontalAlignment="Center"
                                CornerRadius="12"
                                Background="Transparent"
                                Margin="0,0,0,10">

                            <Image x:Name="SettingsBrandingImage"
                                   Stretch="Uniform"/>

                        </Border>

                        <TextBlock Text="MynAssistant"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <TextBlock Text="Ayarlar"
                                   Foreground="#657287"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                    <Button x:Name="GeneralNavButton"
                            Content="Genel"
                            Tag="Active"
                            Style="{StaticResource NavButton}"
                            Click="GeneralNav_Click"/>

                    <Button x:Name="AgentNavButton"
                            Content="Agent"
                            Tag="Normal"
                            Style="{StaticResource NavButton}"
                            Click="AgentNav_Click"/>

                    <Button x:Name="AccountNavButton"
                            Content="Hesap"
                            Tag="Normal"
                            Style="{StaticResource NavButton}"
                            Click="AccountNav_Click"/>

                    <Button x:Name="PrivacyNavButton"
                            Content="Gizlilik"
                            Tag="Normal"
                            Style="{StaticResource NavButton}"
                            Click="PrivacyNav_Click"/>

                    <Button x:Name="ShortcutNavButton"
                            Content="Kısayollar"
                            Tag="Normal"
                            Style="{StaticResource NavButton}"
                            Click="ShortcutNav_Click"/>

                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="MynAssistant"
                           Foreground="#364356"
                           FontSize="10"
                           Margin="0,0,0,4"/>

            </Grid>

        </Border>

        <!-- İÇERİK -->

        <Grid Grid.Column="1"
              Margin="22">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <!-- GENEL -->

                    <StackPanel x:Name="GeneralPanel">

                        <TextBlock Text="Genel"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="MynAssistant'ın genel çalışma davranışları."
                                   Foreground="#718096"
                                   FontSize="12"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Logo ve görünüm"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Ana pencerede görünen logoyu seç. İlk kurulumda KR / Kralus logosu kullanılır. Windows uygulama simgesi ayrı kalır."
                                           Foreground="#7E8A9D"
                                           FontSize="11"
                                           Margin="0,6,0,14"
                                           TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72" Height="72"
                                            Background="#080D13"
                                            CornerRadius="10"
                                            Padding="4">
                                        <Image x:Name="LogoPreviewImage" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <TextBlock x:Name="LogoPresetStatusText"
                                                   Text="KR / Kralus logosu seçili"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#EAF3FC"/>
                                        <TextBlock Text="Seçimin kaydedilir ve sonraki açılışta korunur."
                                                   Foreground="#7E8A9D"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,2,0,0">
                                    <ToggleButton x:Name="KrLogoOptionButton"
                                                  Style="{StaticResource LogoOptionCard}"
                                                  IsChecked="True"
                                                  Click="SelectKrLogo_Click">
                                        <StackPanel VerticalAlignment="Center">
                                            <Image x:Name="KrLogoOptionImage" Width="64" Height="64"
                                                   Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock Text="KR / Kralus" HorizontalAlignment="Center"
                                                       TextAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="AppLogoOptionButton"
                                                  Style="{StaticResource LogoOptionCard}"
                                                  IsChecked="False"
                                                  Click="SelectAppIconLogo_Click">
                                        <StackPanel VerticalAlignment="Center">
                                            <Image x:Name="AppLogoOptionImage" Width="64" Height="64"
                                                   Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock Text="MynAssistant" HorizontalAlignment="Center"
                                                       TextAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton x:Name="CustomLogoOptionButton"
                                                  Style="{StaticResource LogoOptionCard}"
                                                  IsChecked="False"
                                                  Click="SelectCustomLogo_Click">
                                        <StackPanel VerticalAlignment="Center">
                                            <Grid Width="64" Height="64">
                                                <Image x:Name="CustomLogoOptionImage" Stretch="Uniform"/>
                                                <TextBlock x:Name="CustomLogoPlaceholderText" Text="+"
                                                           FontSize="34" Foreground="#66CBEA"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="Özel görsel" HorizontalAlignment="Center"
                                                       TextAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </UniformGrid>


                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Windows bildirimleri"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <CheckBox x:Name="NotificationsCheckBox"
                                          Content="Planlanan işlemler için bildirim göster"
                                          Margin="0,12,0,0"/>

                                <TextBlock Text="10 ve 5 dakika uyarıları bu ayarı kullanır."
                                           Foreground="#7E8A9D"
                                           FontSize="11"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>



                    </StackPanel>

                    <!-- AGENT -->

                    <StackPanel x:Name="AgentPanel"
                                Visibility="Collapsed">

                        <TextBlock Text="Agent"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="MynAssistant'ın arka plan motorunu buradan yönet."
                                   Foreground="#718096"
                                   FontSize="12"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="Agent durumu"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="AgentStatusText"
                                               Text="Kontrol ediliyor..."
                                               Margin="0,7,0,0"
                                               Foreground="#7FD495"
                                               FontSize="12"/>

                                    <TextBlock x:Name="AgentPathText"
                                               Text=""
                                               Margin="0,7,0,0"
                                               Foreground="#627084"
                                               FontSize="10"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="AgentDiagnosticsText"
                                               Text="Son başlatma/hata bilgisi kontrol ediliyor..."
                                               Margin="0,7,0,0"
                                               Foreground="#7E8A9D"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               MaxHeight="58"/>

                                </StackPanel>

                                <Ellipse x:Name="AgentStatusDot"
                                         Grid.Column="1"
                                         Width="12"
                                         Height="12"
                                         Fill="#667085"
                                         VerticalAlignment="Top"
                                         Margin="20,4,0,0"/>

                            </Grid>

                        </Border>

                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Agent yönetimi"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Agent'i doğrudan buradan çalıştırabilir veya yeniden başlatabilirsin."
                                           Foreground="#7E8A9D"
                                           FontSize="11"
                                           Margin="0,6,0,14"
                                           TextWrapping="Wrap"/>

                                <WrapPanel>

                                    <Button Content="Agent'i başlat"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="StartAgent_Click"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Durdur"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="StopAgent_Click"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Yeniden başlat"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="RestartAgent_Click"
                                            Margin="0,0,8,8"/>

                                    <Button Content="Agent günlüklerini aç"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OpenAgentLogs_Click"
                                            Margin="0,0,0,8"/>

                                </WrapPanel>

                            </StackPanel>

                        </Border>



                        <!-- ANDROID - WINDOWS BAGLANTISI -->

                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Telefon-PC bağlantısı"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Android MynAssistant uygulamasını bu Windows bilgisayara bağlayan köprü."
                                           Foreground="#7E8A9D"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="DesktopBridgeStatusText"
                                           Text="Kontrol ediliyor..."
                                           Margin="0,12,0,0"
                                           Foreground="#7FD495"
                                           FontSize="12"/>

                                <Ellipse x:Name="DesktopBridgeStatusDot"
                                         Width="10"
                                         Height="10"
                                         Fill="#667085"
                                         HorizontalAlignment="Left"
                                         Margin="0,6,0,0"/>

                                <TextBlock x:Name="DesktopBridgeExecutablePathText"
                                           Text=""
                                           Margin="0,7,0,0"
                                           Foreground="#627084"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="DesktopBridgeMessageText"
                                           Text=""
                                           Margin="0,5,0,0"
                                           Foreground="#9BA9BB"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,12,0,0">

                                    <Button Content="Bağlantıyı başlat"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="StartDesktopBridge_Click"
                                            Margin="0,0,8,8"/>

                                    <Button Content="Durdur"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="StopDesktopBridge_Click"
                                            Margin="0,0,8,8"/>

                                    <Button Content="Yeniden başlat"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="RestartDesktopBridge_Click"
                                            Margin="0,0,0,8"/>

                                </WrapPanel>

                                <CheckBox x:Name="DesktopBridgeStartupCheckBox"
                                          Content="Windows açılışında telefon-PC bağlantısını başlat"
                                          Margin="0,8,0,0"/>

                                <TextBlock Text="Telefon-PC bağlantısı Hesap bölümündeki Firebase oturumunu kullanır. Yerel Agent bu oturumdan bağımsızdır."
                                           Foreground="#7E8A9D"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- HESAP -->

                    <StackPanel x:Name="AccountPanel"
                                Visibility="Collapsed">

                        <TextBlock Text="Hesap"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Telefon-PC bağlantı durumu otomatik kontrol edilir. Google Kişiler isteğe bağlıdır."
                                   Foreground="#718096"
                                   FontSize="12"
                                   Margin="0,0,0,18"
                                   TextWrapping="Wrap"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Telefon-PC bağlantısı" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DesktopBridgeStatusText" Text="Bağlantı durumu kontrol ediliyor..."
                                           Foreground="#D6E5F4" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <Ellipse x:Name="DesktopBridgeStatusDot" Width="10" Height="10" Fill="#667085"
                                         HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <TextBlock x:Name="DesktopBridgeExecutablePathText" Text="" Margin="0,7,0,0"
                                           Foreground="#627084" FontSize="10" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DesktopBridgeMessageText" Text="" Margin="0,5,0,0"
                                           Foreground="#9BA9BB" FontSize="11" TextWrapping="Wrap"/>
                                <Button Content="Bağlantıyı yenile" Style="{StaticResource PrimaryButton}"
                                        Click="RefreshDesktopBridge_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="52"
                                        Height="52"
                                        CornerRadius="26"
                                        BorderBrush="#29405A"
                                        BorderThickness="1">

                                    <Image x:Name="GooglePhoto"
                                           Source="Resources/myn.jpg"
                                           Stretch="UniformToFill"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="14,0,0,0">

                                    <TextBlock x:Name="GoogleNameText"
                                               Text="Google hesabı bağlı değil"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="GoogleEmailText"
                                               Text=""
                                               Foreground="#7D899B"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                                <Button x:Name="GoogleConnectButton"
                                        Grid.Column="2"
                                        Content="Kişileri bağla"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="GoogleConnectButton_Click"
                                        VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Google Kişiler (isteğe bağlı)"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <CheckBox x:Name="GoogleContactsCheckBox"
                                          Content="Google Kişiler listeme eriş"
                                          IsEnabled="False"
                                          Margin="0,12,0,0"
                                          Checked="GoogleContactsCheckBox_Checked"
                                          Unchecked="GoogleContactsCheckBox_Unchecked"/>

                                <TextBlock Text="Kişi ekleme ve iletişim özellikleri bu erişimi kullanabilir."
                                           Foreground="#7E8A9D"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- GİZLİLİK -->

                    <StackPanel x:Name="PrivacyPanel"
                                Visibility="Collapsed">

                        <TextBlock Text="Gizlilik"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Mikrofon ve kamera özelliklerini yönet."
                                   Foreground="#718096"
                                   FontSize="12"
                                   Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Mikrofon"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <CheckBox x:Name="MicrophoneCheckBox"
                                          Content="MynAssistant mikrofon özelliğini etkinleştir"
                                          Margin="0,12,0,10"/>

                                <Button Content="Windows mikrofon gizlilik ayarlarını aç"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Click="OpenMicrophoneSettings_Click"/>

                            </StackPanel>

                        </Border>

                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Kamera"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <CheckBox x:Name="CameraCheckBox"
                                          Content="MynAssistant kamera özelliğini etkinleştir"
                                          Margin="0,12,0,10"/>

                                <Button Content="Windows kamera gizlilik ayarlarını aç"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Click="OpenCameraSettings_Click"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- KISAYOLLAR -->

                    <StackPanel x:Name="ShortcutPanel"
                                Visibility="Collapsed">

                        <TextBlock Text="Kısayollar"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="MynAssistant'ı başka uygulamadayken öne getirmek için global kısayol."
                                   Foreground="#718096"
                                   FontSize="12"
                                   Margin="0,0,0,18"
                                   TextWrapping="Wrap"/>

                        <Border Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="MynAssistant'ı öne getir"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Örneğin Ctrl + Shift + Space tuşlarına bas."
                                           Foreground="#7E8A9D"
                                           FontSize="11"
                                           Margin="0,6,0,12"/>

                                <TextBox x:Name="HotkeyTextBox"
                                         Width="260"
                                         HorizontalAlignment="Left"
                                         Padding="10,8"
                                         Background="#0B1118"
                                         Foreground="#FFFFFF"
                                         BorderBrush="#2A3B52"
                                         BorderThickness="1"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>

                                <WrapPanel Margin="0,10,0,0">

                                    <Button Content="Kısayolu temizle"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="ClearHotkey_Click"
                                            Margin="0,0,10,0"/>

                                    <TextBlock x:Name="HotkeyInfoText"
                                               Text=""
                                               Foreground="#7FD495"
                                               VerticalAlignment="Center"
                                               FontSize="11"/>

                                </WrapPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

            </ScrollViewer>

            <!-- ALT -->

            <Grid Grid.Row="1"
                  Margin="0,14,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SaveStatusText"
                           Text=""
                           Foreground="#7FD495"
                           VerticalAlignment="Center"
                           FontSize="11"/>

                <Button Grid.Column="1"
                        Content="Kaydet"
                        Width="95"
                        Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="Kapat"
                        Width="90"
                        Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click"/>

            </Grid>

        </Grid>

    </Grid>

</Window>
