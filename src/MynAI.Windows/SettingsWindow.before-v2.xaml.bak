<Window x:Class="MynAI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MynAI Ayarlar"
        Width="760"
        Height="560"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#080C12"
        Foreground="#F3F6FA"
        ResizeMode="NoResize"
        Icon="Resources/myn.ico">

    <Window.Resources>

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#75839A"/>
            <Setter Property="Margin"
                    Value="2,0,0,9"/>
        </Style>

        <Style x:Key="Card"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#0E141D"/>
            <Setter Property="BorderBrush"
                    Value="#202D40"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="14"/>
        </Style>

        <Style x:Key="ActionButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#1A73E8"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="15,9"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#2583F2"/>
                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="26">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="0,0,0,24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="48"
                    Height="48"
                    CornerRadius="12"
                    Background="#020306"
                    BorderBrush="#26354B"
                    BorderThickness="1">

                <Image Source="Resources/myn.jpg"
                       Width="42"
                       Height="42"
                       Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="MynAI"
                           FontSize="21"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Ayarlar"
                           Margin="0,3,0,0"
                           FontSize="11"
                           Foreground="#7F8CA0"/>

            </StackPanel>

        </Grid>

        <!-- CONTENT -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- GOOGLE -->

                <TextBlock Text="GOOGLE HESABI"
                           Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,22">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="50"
                                Height="50"
                                Background="#182230"
                                CornerRadius="25"
                                VerticalAlignment="Center">

                            <Image x:Name="GooglePhoto"
                                   Width="50"
                                   Height="50"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="14,0,16,0"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="GoogleNameText"
                                       Text="Google hesabı bağlı değil"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="GoogleEmailText"
                                       Text="Hesabınızı bağlayarak MynAI ile kullanabilirsiniz."
                                       Margin="0,4,0,0"
                                       Foreground="#8491A4"
                                       FontSize="11"/>

                        </StackPanel>

                        <Button x:Name="GoogleConnectButton"
                                Grid.Column="2"
                                Content="Google ile bağlan"
                                Click="GoogleConnectButton_Click"
                                Style="{StaticResource ActionButton}"
                                VerticalAlignment="Center"/>

                    </Grid>

                </Border>

                <!-- CONTACTS -->

                <TextBlock Text="GOOGLE KİŞİLER"
                           Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource Card}"
                        Padding="16"
                        Margin="0,0,0,22">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Kişilere erişim"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Google Kişiler listenizi MynAI içinde kullanın."
                                       Margin="0,5,0,0"
                                       Foreground="#8491A4"
                                       FontSize="11"/>

                        </StackPanel>

                        <CheckBox x:Name="GoogleContactsCheckBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  IsEnabled="False"
                                  Checked="GoogleContactsCheckBox_Checked"
                                  Unchecked="GoogleContactsCheckBox_Unchecked"
                                  Width="20"
                                  Height="20"/>

                    </Grid>

                </Border>

                <!-- GENERAL -->

                <TextBlock Text="UYGULAMA"
                           Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource Card}"
                        Padding="16">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Windows bildirimleri"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Planlanan işlemler için bildirim göster."
                                       Margin="0,5,0,0"
                                       Foreground="#8491A4"
                                       FontSize="11"/>

                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Width="20"
                                  Height="20"/>

                    </Grid>

                </Border>

            
                <Border Background="#101620"
                        BorderBrush="#263449"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="MynAI Agent"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <CheckBox x:Name="AgentStartupCheckBox"
                                  Content="Windows açılışında Agent'i çalıştır"
                                  Margin="0,12,0,0"
                                  FontSize="12"/>

                        <TextBlock Text="Agent zamanlayıcı ve arka plan görevlerini Windows ile birlikte başlatır."
                                   Margin="0,5,0,0"
                                   Foreground="#8993A5"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>
            </StackPanel>

        </ScrollViewer>

        <!-- FOOTER -->

        <Grid Grid.Row="2"
              Margin="0,18,0,0">

            <TextBlock Text="MynAI"
                       VerticalAlignment="Center"
                       Foreground="#58677D"
                       FontSize="10"/>

                    <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <TextBlock x:Name="SaveStatusText"
                       Text=""
                       Foreground="#7FD495"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0"/>

            <Button Content="Kaydet"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    Padding="10,7"/>

            <Button Content="Kapat"
                    Width="90"
                    Click="CloseButton_Click"
                    Padding="10,7"/>

        </StackPanel>
        </Grid>

    </Grid>

</Window>





