\pard\sa240\b\fs30 MYNASSISTANT - SON KULLANICI LISANS KOSULLARI\b0\fs20\par
\pard\sa160 Surum: 0.1.2\par
\pard\sa160 Bu sozlesme, MynAssistant Windows uygulamasinin ("Yazilim") kurulumu ve kullanimi icin temel kosullari aciklar. Kuruluma devam ederek bu kosullari kabul etmis olursun. Kabul etmiyorsan kurulumu iptal et.\par
\pard\sb180\sa100\b 1. Lisans hakki\b0\par
\pard\sa160 Yazilim, kisisel ve hukuka uygun kullanim amaciyla, sana ait veya kullanmaya yetkili oldugun Windows cihazlarinda kullanilmak uzere lisanslanir. Bu hak devredilemez. Yazilimi satamaz, alt lisansla dagitamaz veya izin alinmadan yeniden dagitamazsin.\par
\pard\sb180\sa100\b 2. Yetkili kullanim ve guvenlik\b0\par
\pard\sa160 Yazilimi yalnizca sahibi oldugun veya kullanma ve yonetme iznine sahip oldugun cihaz ve hesaplarda kullan. Yetkisiz erisim, izinsiz uzaktan kontrol, guvenlik onlemlerini asma veya baskalarinin sistemlerine zarar verme amaciyla kullanma. Bu kosula uygun kullan\u305?mdan sen sorumlusun.\par
\pard\sb180\sa100\b 3. Hesaplar ve ucuncu taraf hizmetleri\b0\par
\pard\sa160 Etkinlestirdigin ozelliklere gore Yazilim Google oturumu, Google API'leri, ag hizmetleri veya ayri kurdugun entegrasyonlarla iletisim kurabilir. Bu hizmetlerin kendi kosullari, izinleri ve kullanilabilirlik sinirlari bulunabilir. Ucuncu taraf hizmetlerinin kesintisiz veya hatasiz calisacagi garanti edilmez.\par
\pard\sb180\sa100\b 4. Veri ve yedekleme\b0\par
\pard\sa160 Yazilimi kullanirken girdigin komut, hesap, ayar veya dosyalarin iceriginden ve gerekli izinleri vermekten sen sorumlusun. Gizli anahtar, parola veya gereksiz hassas bilgileri komutlara ya da paylasilan kayitlara ekleme. Onemli verilerinin yedegini sakla.\par
\pard\sb180\sa100\b 5. Fikri mulkiyet ve ucuncu taraf bilesenleri\b0\par
\pard\sa160 Yazilim ve MynAssistant markasina ait adlar, simgeler ve ozgun materyaller ilgili hak sahiplerine aittir. Yazilimla birlikte gelen ucuncu taraf bilesenleri kendi lisans kosullarina tabidir; bu sozlesme o lisanslari degistirmez.\par
\pard\sb180\sa100\b 6. Garanti ve sorumluluk\b0\par
\pard\sa160 Yazilim, uygulanabilir hukukun izin verdigi olcude, "oldugu gibi" sunulur. Belirli bir amaca uygunluk, hatasiz calisma, kesintisiz erisim veya her cihazda ayni davranis garanti edilmez. Uygulanabilir hukukun zorunlu haklari sakli kalmak kaydiyla, yedeksiz veri kaybi, ucuncu taraf servis kesintisi veya yetkisiz/kanuna aykiri kullanimdan dogan zararlardan Yazilim gelistiricisi sorumlu tutulamaz.\par
\pard\sb180\sa100\b 7. Guncellemeler ve sona erdirme\b0\par
\pard\sa160 Yazilimin ozellikleri ve desteklenen surumleri zamanla degisebilir. Bu kosullara uymadiginda Yazilimi kullanmayi birakmali ve bilgisayarindan kaldirmalisin.\par
\pard\sb180\sa100\b 8. Kabul\b0\par
\pard\sa160 Kuruluma devam etmen, yukaridaki kosullari okudugunu ve kabul ettigini belirtir. Kosullari kabul etmiyorsan "Iptal" secenegini kullan.\par
